# RecoverAI Environment Configuration Template
# Copy this file to .env before starting: cp .env.example .env

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=recoverai
DATABASE_URL=postgresql://postgres:changeme@db:5432/recoverai

# LLM Configuration (One provider, one API - no frameworks)
# Required for single-transaction LLM recommendation (Phase 6) and LLM diagnosis (Phase 4)
# Note: Batch A/B evaluation (Phase 9) runs fully autonomously via deterministic EV + Policy engines.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
